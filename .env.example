# Select gateway API or chatgpt-subscription for the official Codex login.
JEVPILOT_LLM_PROVIDER=gateway

# Chosun University API Gateway; keep this beside the Jev key in local .env.
# The gateway supports multiple model providers through one API key.
JEVPILOT_LLM_API_KEY=
JEVPILOT_LLM_MODEL=gpt-6.1-sol

# TypeSafe Jev API key
JEVPILOT_JEV_API_KEY=

# Required explicit Jev model identifier; no guessed production default.
JEVPILOT_JEV_MODEL=jev-latest

# Optional endpoint override for offline tests or controlled deployments.
JEVPILOT_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone

# Benchmark-only spending controls. Product CLI runs have no project-imposed cap.
JEVPILOT_TEST_LLM_CREDIT_LIMIT=10000
JEVPILOT_TEST_JEV_SPEND_LIMIT_USD=1
JEVPILOT_TEST_JEV_RESERVATION_USD=0.01

# Required for jev_hybrid and compare. Tune on a separate fixture set.
JEVPILOT_JEV_OPERATION_THRESHOLD=0.5
JEVPILOT_JEV_TARGET_THRESHOLD=0.5
