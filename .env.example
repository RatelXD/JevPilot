# 새 셸: 먼저 uv run jevpilot → /login에서 API 또는 ChatGPT 구독과 모델을 선택합니다.
# ChatGPT 구독에도 별도의 Jev(TypeSafe) API 키가 필요합니다.
# 키를 /login에서 저장했다면 아래 환경변수는 생략할 수 있습니다.
# 비어 있지 않은 환경변수는 ~/.jevpilot/credentials.json의 저장값보다 우선합니다.
# 실제 키는 로컬 .env에만 넣고 커밋하지 마세요.
# uv run --env-file .env jevpilot처럼 같은 실행에 주입합니다. 자동 로드는 하지 않습니다.
JEVPILOT_JEV_API_KEY=

# 새 셸의 API 공급자는 OpenAI와 Anthropic만 지원합니다.
# 키만 지정해도 모델 프로필이 생기지는 않습니다. 먼저 /login으로 설정합니다.
# JEVPILOT_OPENAI_API_KEY=
# JEVPILOT_ANTHROPIC_API_KEY=

# Jev 모델과 엔드포인트를 바꿀 때만 사용합니다.
# JEVPILOT_JEV_MODEL=jev-latest
# JEVPILOT_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone

# 테스트·QA 전용: OpenAI 공급자를 로컬 가짜 서버에 연결합니다.
# 일반 사용자용 호환 공급자나 자동 대체 경로가 아닙니다.
# JEVPILOT_OPENAI_BASE_URL=http://127.0.0.1:8799/v1

# 실제 Chrome을 사용하는 browser 마커 테스트를 명시적으로 켤 때만 사용합니다.
# 일반 pytest는 이 설정 없이 실행합니다.
# JEVPILOT_BROWSER_TESTS=1

# 아래 설정은 동결된 v1의 jevpilot run ... 전용입니다.
# 새 셸의 적응형 정책은 ~/.jevpilot/profile.json의 policy_overrides를 사용합니다.
# JEVPILOT_JEV_OPERATION_THRESHOLD=0.5
# JEVPILOT_JEV_TARGET_THRESHOLD=0.5

# v1 Gateway 경로입니다. 새 /login 메뉴에서는 Gateway를 제공하지 않습니다.
# v1 구독 경로의 provider 값은 chatgpt-subscription입니다.
# JEVPILOT_LLM_PROVIDER=gateway
# JEVPILOT_LLM_API_KEY=
# JEVPILOT_LLM_MODEL=gpt-6.1-sol

# 이전 계획의 Google, OpenRouter, COMPAT 키·URL은 새 인증 저장소에서 지원하지 않습니다.
# 새 공급자 목록은 src/jevpilot/llm/credentials.py를 기준으로 합니다.
